{
  "servers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "local-postgres": {
      "command": "node",
      "args": [
          "--env-file=.env.local", // specify the environment file to use for DB config variables
          "node_modules/@yawlabs/postgres-mcp/dist/index.js" // yawlabs must be installed in the project for this to work (run `npm install @yawlabs/postgres-mcp` to install it)
      ]
    }
  }
}